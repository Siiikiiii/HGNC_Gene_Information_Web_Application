
git clone https://github.com/Siiikiiii/HGNC_Gene_Information_Web_Application.git
cd HGNC_Gene_Information_Web_Application
mkdir -p data tests hgnc_app
curl -o data/hgnc_complete_set.txt https://storage.googleapis.com/public-download-files/hgnc/tsv/tsv/hgnc_complete_set.txt

conda env create -f environment.yml
conda activate hgnc_env
pip install -e .

pytest --cov=hgnc_app --cov-report=html

git add .
git commit -m "Refine data parser type hints, clean up settings path, and update test suite"
git push